<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Device Bound Session Credentials (DBSC) for ASP.NET Core cookie authentication. Community fork of the experimental Microsoft.AspNetCore.Authentication.DeviceBoundSessions package that was removed in .NET 11 RC2.</Description>
    <PackageId>ThorstenSauter.AspNetCore.Authentication.DeviceBoundSessions</PackageId>
    <VersionPrefix>0.1.1</VersionPrefix>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageTags>aspnetcore;authentication;dbsc;device-bound-sessions;security</PackageTags>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Checks the package against NuGet's compatibility rules and against the last stable release; bump the baseline after each stable release. -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>0.1.0</PackageValidationBaselineVersion>
    <!-- Runtime async (.NET 11): the runtime, not a compiler-generated state machine, suspends and resumes this library's async methods. -->
    <Features>$(Features);runtime-async=on</Features>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Microsoft.AspNetCore.Authentication" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <!-- Embeds an SPDX 3.0.1 SBOM at _manifest/spdx_3.0/manifest.spdx.json, built from packages.lock.json. -->
    <PackageReference Include="Sbom" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Public API baseline: new or changed public members fail the build (RS0016/RS0017) until recorded here. -->
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ThorstenSauter.AspNetCore.Authentication.DeviceBoundSessions.Tests" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../assets/icon.png" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
