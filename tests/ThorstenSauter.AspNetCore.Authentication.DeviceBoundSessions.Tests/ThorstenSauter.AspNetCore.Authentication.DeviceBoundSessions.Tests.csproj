  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/ThorstenSauter.AspNetCore.Authentication.DeviceBoundSessions/ThorstenSauter.AspNetCore.Authentication.DeviceBoundSessions.csproj" />
  </ItemGroup>

</Project>
